# 复制为 .env 后修改（Node ≥ 20.12 会自动读取，无需 dotenv）

PORT=3000

# ── AI 自由聊天（可选）──
# 不配置则使用离线规则回复，游戏流程完全可用
ANTHROPIC_API_KEY=
# 默认 claude-opus-5-5；effort 默认 low（闲聊场景延迟优先），可选 low / medium / high
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low
# 强制指定提供方：anthropic / mock
# LLM_PROVIDER=

# ── 统计页访问令牌（可选）──
# 设置后访问 /stats.html?token=xxx 才能看数据
# STATS_TOKEN=

# ── 其他 ──
# Cookie 签名密钥，不填则自动生成并保存在 data/.cookie-secret
# COOKIE_SECRET=
# 数据目录（订单、解锁记录、埋点），部署时挂到持久化磁盘
# DATA_DIR=./data
# 每用户每分钟最多聊天消息数
# CHAT_RATE_PER_MINUTE=12
